{
  "name": "xpoz-intelligence-pipeline-manager",
  "version": "0.1.0",
  "description": "Reddit Intelligence Pipeline using Xpoz MCP API",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "run:pipeline": "tsx src/index.ts --output both",
    "run:notify": "tsx src/index.ts --output both --notify",
    "run:force": "tsx src/index.ts --output both --notify --force",
    "daemon": "tsx src/index.ts --daemon --notify",
    "history": "tsx src/index.ts --history"
  },
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^12.9.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
