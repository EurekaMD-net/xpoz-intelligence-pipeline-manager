{
  "name": "xpoz-intelligence-pipeline-manager",
  "version": "0.1.0",
  "description": "Reddit Intelligence Pipeline using Xpoz MCP API",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "run:pipeline": "tsx --env-file=.env src/index.ts --output both",
    "run:notify": "tsx --env-file=.env src/index.ts --output both --notify",
    "run:force": "tsx --env-file=.env src/index.ts --output both --notify --force",
    "daemon": "tsx --env-file=.env src/index.ts --daemon --notify",
    "serve": "tsx --env-file=.env src/index.ts --serve",
    "serve:all": "tsx --env-file=.env src/index.ts --serve --daemon --notify",
    "history": "tsx --env-file=.env src/index.ts --history",
    "mcp": "tsx --env-file=.env mcp-server.ts",
    "build": "tsc",
    "build:mcp": "tsc && echo 'MCP server compiled to dist/mcp-server.js'"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^12.9.0",
    "hono": "^4.12.14",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
